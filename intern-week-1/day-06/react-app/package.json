{
  "name": "day-06-react-typescript-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "server": "json-server --watch server/db.json --port 3001",
    "start": "concurrently -k -n \"API,APP\" -c \"magenta,cyan\" \"npm run server\" \"npm run dev\"",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "json-server": "^0.17.4",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}
